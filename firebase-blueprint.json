{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "lead": {
      "title": "Lead",
      "description": "Potential customer captured by agents",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "qualified", "quoted", "closed", "lost"] },
        "interest": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "phone", "status"]
    },
    "chatSession": {
      "title": "Chat Session",
      "description": "A conversation between a user and the assistant line",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "currentAgent": { "type": "string", "enum": ["SOFIA", "LUCAS", "ELENA", "POSVENDA"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "currentAgent"]
    },
    "message": {
      "title": "Message",
      "description": "Individual message in a chat session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "agent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "role", "content"]
    },
    "prescription": {
      "title": "Prescription",
      "description": "Uploaded prescription record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "analyzed", "quoted"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fileName", "status"]
    },
    "newsletter": {
      "title": "Newsletter",
      "description": "Marketing email subscription",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "productNotification": {
      "title": "Product Notification",
      "description": "User request to be notified when a product returns to stock",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "productId": { "type": "number" },
        "productName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "notified"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "productId", "status"]
    },
    "wishlistItem": {
      "title": "Wishlist Item",
      "description": "Product saved by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId"]
    },
    "review": {
      "title": "Review",
      "description": "Product rating and comment",
      "type": "object",
      "properties": {
        "productId": { "type": "number" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    },
    "order": {
      "title": "Order",
      "description": "Customer purchase record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "string" },
        "status": { "type": "string", "enum": ["processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/leads/{leadId}": {
      "schema": "lead",
      "description": "Sales leads"
    },
    "/chatSessions/{sessionId}": {
      "schema": "chatSession",
      "description": "Active and past chat sessions"
    },
    "/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": "message",
      "description": "Messages within a chat session"
    },
    "/prescriptions/{prescriptionId}": {
      "schema": "prescription",
      "description": "User uploaded prescriptions"
    },
    "/newsletter/{subscriberId}": {
      "schema": "newsletter",
      "description": "Marketing subscribers"
    },
    "/productNotifications/{notificationId}": {
      "schema": "productNotification",
      "description": "Stock alerts"
    },
    "/wishlist/{wishId}": {
      "schema": "wishlistItem",
      "description": "User saved products"
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Product reviews"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Order history"
    }
  }
}
